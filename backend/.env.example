PROJECT_NAME="Signal Clone Backend"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_JSON="true"

SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_BACKEND="sqlite"
SQLITE_DATABASE_PATH="./signal_clone.db"
DATABASE_URL=""
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_DB="signal"
POSTGRES_USER="signal"
POSTGRES_PASSWORD="signal"

BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

REDIS_BACKEND="memory"
REDIS_URL="redis://localhost:6379/0"

STORAGE_BACKEND="local"
STORAGE_LOCAL_PATH="./storage"
STORAGE_PUBLIC_BASE_URL="/api/v1/attachments/download"
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_ALLOWED_MIME_TYPES='["image/jpeg","image/png","image/gif","image/webp","video/mp4","video/mpeg","video/quicktime","video/webm","audio/mpeg","audio/ogg","audio/wav","audio/webm","audio/aac","audio/mp4","application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain"]'

S3_BUCKET="signal"
S3_REGION="auto"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

SCHEDULER_BACKEND="async"
NOTIFICATION_BACKEND="mock"
